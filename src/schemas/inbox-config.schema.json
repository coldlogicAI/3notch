{
  "$id": "https://3notch.dev/schemas/inbox-config.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "transport", "name", "address", "root"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "transport": { "const": "local" },
    "name": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,62}[a-z0-9])?$" },
    "address": { "type": "string", "pattern": "^local:[a-z0-9](?:[a-z0-9._-]{0,62}[a-z0-9])?$" },
    "root": { "type": "string", "minLength": 1 }
  }
}
